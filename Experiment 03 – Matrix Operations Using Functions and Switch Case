
#include <iostream>
using namespace std;

const int MAX = 10;

void inputMatrix(int a[MAX][MAX], int r, int c)
{
    cout << "Enter matrix elements:\n";
    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            cin >> a[i][j];
}

void displayMatrix(int a[MAX][MAX], int r, int c)
{
    for (int i = 0; i < r; i++)
    {
        for (int j = 0; j < c; j++)
            cout << a[i][j] << "\t";
        cout << endl;
    }
}

void addition(int a[MAX][MAX], int b[MAX][MAX], int r, int c)
{
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[i][j] = a[i][j] + b[i][j];

    cout << "Addition:\n";
    displayMatrix(result, r, c);
}

void subtraction(int a[MAX][MAX], int b[MAX][MAX], int r, int c)
{
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[i][j] = a[i][j] - b[i][j];

    cout << "Subtraction:\n";
    displayMatrix(result, r, c);
}

void multiplication(int a[MAX][MAX], int b[MAX][MAX],
                    int r1, int c1, int c2)
{
    int result[MAX][MAX] = {};

    for (int i = 0; i < r1; i++)
        for (int j = 0; j < c2; j++)
            for (int k = 0; k < c1; k++)
                result[i][j] += a[i][k] * b[k][j];

    cout << "Multiplication:\n";
    displayMatrix(result, r1, c2);
}

void transpose(int a[MAX][MAX], int r, int c)
{
    int result[MAX][MAX];

    for (int i = 0; i < r; i++)
        for (int j = 0; j < c; j++)
            result[j][i] = a[i][j];

    cout << "Transpose:\n";
    displayMatrix(result, c, r);
}

int main()
{
    int a[MAX][MAX], b[MAX][MAX];
    int r1, c1, r2, c2, choice;

    cout << "1. Addition\n";
    cout << "2. Subtraction\n";
    cout << "3. Multiplication\n";
    cout << "4. Transpose\n";

    cout << "Enter your choice: ";
    cin >> choice;

    switch (choice)
    {
        case 1:
        case 2:
            cout << "Enter rows and columns: ";
            cin >> r1 >> c1;

            if (r1 < 1 || r1 > MAX || c1 < 1 || c1 > MAX)
            {
                cout << "Invalid dimensions";
                break;
            }

            cout << "Enter first matrix:\n";
            inputMatrix(a, r1, c1);

            cout << "Enter second matrix:\n";
            inputMatrix(b, r1, c1);

            if (choice == 1)
                addition(a, b, r1, c1);
            else
                subtraction(a, b, r1, c1);
            break;

        case 3:
            cout << "Enter rows and columns of first matrix: ";
            cin >> r1 >> c1;

            cout << "Enter rows and columns of second matrix: ";
            cin >> r2 >> c2;

            if (r1 < 1 || r1 > MAX || c1 < 1 || c1 > MAX ||
                r2 < 1 || r2 > MAX || c2 < 1 || c2 > MAX)
            {
                cout << "Invalid dimensions";
                break;
            }

            if (c1 != r2)
            {
                cout << "Multiplication not possible";
                break;
            }

            cout << "Enter first matrix:\n";
            inputMatrix(a, r1, c1);

            cout << "Enter second matrix:\n";
            inputMatrix(b, r2, c2);

            multiplication(a, b, r1, c1, c2);
            break;

        case 4:
            cout << "Enter rows and columns: ";
            cin >> r1 >> c1;

            if (r1 < 1 || r1 > MAX || c1 < 1 || c1 > MAX)
            {
                cout << "Invalid dimensions";
                break;
            }

            cout << "Enter matrix:\n";
            inputMatrix(a, r1, c1);

            transpose(a, r1, c1);
            break;

        default:
            cout << "Invalid choice!";
    }

    return 0;
}
